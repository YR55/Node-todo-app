<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Todo</title>

    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f6f8;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        color: #111827;
      }

      .card {
        background: #ffffff;
        padding: 24px 30px;
        border-radius: 8px;
        width: 400px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      }

      h1 {
        margin-bottom: 20px;
        font-size: 22px;
        text-align: center;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
      }

      input[type="text"] {
        width: 100%;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 5px;
        border: 1px solid #ccc;
        font-size: 14px;
      }

      .actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      button {
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        background-color: #2563eb;
        color: #ffffff;
      }

      button:hover {
        background-color: #1d4ed8;
      }

      .cancel-btn {
        text-decoration: none;
        color: #555;
        font-size: 14px;
      }

      .cancel-btn:hover {
        text-decoration: underline;
      }

      /* Mobile */
      @media (max-width: 600px) {
        .card {
          width: 100%;
          margin: 15px;
        }
      }

      /* Dark Mode */
      @media (prefers-color-scheme: dark) {
        body {
          background-color: #0f172a;
          color: #e5e7eb;
        }

        .card {
          background-color: #020617;
          box-shadow: none;
        }

        input[type="text"] {
          background-color: #020617;
          color: #e5e7eb;
          border-color: #334155;
        }

        .cancel-btn {
          color: #9ca3af;
        }

        button {
          background-color: #3b82f6;
        }
      }
    </style>
  </head>

  <body>
    <div class="card">
      <h1>Edit Todo</h1>

      <form action="/todo/edit/<%= todoIdx %>" method="post">
        <input type="hidden" name="_method" value="PUT" />

        <label for="editTodo">Update task</label>
        <input
          type="text"
          name="editTodo"
          id="editTodo"
          value="<%- todo %>"
          required
          autofocus
        />

        <div class="actions">
          <a href="/" class="cancel-btn">Cancel</a>
          <button type="submit">Save</button>
        </div>
      </form>
    </div>
  </body>
</html>
