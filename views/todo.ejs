<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo List</title>

    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f6f8;
        margin: 0;
        padding: 0;
        color: #111827;
      }

      header {
        background-color: #2563eb;
        color: #ffffff;
        padding: 18px;
        text-align: center;
      }

      header h1 {
        margin: 0;
        font-size: 22px;
      }

      .container {
        max-width: 700px;
        margin: 30px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      li {
        padding: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .todo-text {
        font-size: 15px;
      }

      .actions a {
        margin-left: 12px;
        text-decoration: none;
        font-size: 14px;
      }

      .edit-btn {
        color: #f59e0b;
      }

      .delete-btn {
        color: #ef4444;
      }

      .actions a:hover {
        text-decoration: underline;
      }

      form {
        margin-top: 25px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
      }

      input[type="text"] {
        width: 100%;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #d1d5db;
        margin-bottom: 12px;
        font-size: 14px;
      }

      button {
        background-color: #2563eb;
        color: #ffffff;
        border: none;
        padding: 10px 18px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
      }

      button:hover {
        background-color: #1d4ed8;
      }

      .empty {
        text-align: center;
        color: #6b7280;
        margin: 20px 0;
      }

      /* Mobile Responsive */
      @media (max-width: 600px) {
        .container {
          margin: 15px;
          padding: 18px;
        }

        header h1 {
          font-size: 18px;
        }

        button {
          width: 100%;
        }
      }

      /* Dark Mode */
      @media (prefers-color-scheme: dark) {
        body {
          background-color: #0f172a;
          color: #e5e7eb;
        }

        header {
          background-color: #020617;
        }

        .container {
          background-color: #020617;
          box-shadow: none;
        }

        li {
          background-color: #020617;
          border-color: #1e293b;
        }

        input[type="text"] {
          background-color: #020617;
          color: #e5e7eb;
          border-color: #334155;
        }

        button {
          background-color: #3b82f6;
        }

        .edit-btn {
          color: #fbbf24;
        }

        .delete-btn {
          color: #f87171;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <h1>Todo List Application</h1>
    </header>

    <div class="container">
      <% if (todolist.length === 0) { %>
        <p class="empty">No tasks added yet.</p>
      <% } %>

      <ul>
        <% todolist.forEach(function(todo, index) { %>
          <li>
            <span class="todo-text"><%- todo %></span>
            <div class="actions">
              <a href="/todo/<%= index %>" class="edit-btn">Edit</a>
              <a href="/todo/delete/<%= index %>" class="delete-btn">Delete</a>
            </div>
          </li>
        <% }); %>
      </ul>

      <form action="/todo/add/" method="post">
        <label for="newtodo">Add a new task</label>
        <input
          type="text"
          name="newtodo"
          id="newtodo"
          placeholder="Enter your task"
          required
        />
        <button type="submit">Add Task Ok</button>
      </form>
    </div>
  </body>
</html>
